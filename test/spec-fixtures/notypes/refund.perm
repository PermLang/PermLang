perm process_refund(id: Text) -> Result
  implements: refund.ts#processRefund
  perms:
    db.write(refunds)

perm read_key() -> Text
  implements: refund.ts#readKey
  perms:
    env(REFUND_KEY)

perm refund_and_notify(id: Text)
  implements: refund.ts#refundAndNotify
  perms:
    net(ops.example)

perm format_amount(cents: Number) -> Text
  implements: refund.ts#formatAmount
  perms:
    net(unused.example)
